                },
                {
                    "name": "keyword.other.rest.sql",
                    "match": "(?i)(?<![\\w$])(?:AUTHENTICATION|DEVELOPMENT|REDIRECTION|UNPUBLISHED|AUTODETECT|MANAGEMENT|PARAMETERS|PROCEDURES|TYPESCRIPT|AVAILABLE|CONFIGURE|ENDPOINTS|FUNCTIONS|HIERARCHY|INCLUDING|PUBLISHED|DISABLED|METADATA|PROTOCOL|REGISTER|REQUIRED|SERVICES|CONTENT|DAEMONS|ENABLED|EXTENDS|INCLUDE|MAPPING|MARIADB|OBJECTS|PRIVATE|REQUEST|SCRIPTS|SERVICE|VENDORS|DAEMON|FILTER|RESULT|SECRET|STATIC|VENDOR|ALLOW|CLASS|CLONE|FILES|HTTPS|ITEMS|MEDIA|ROLES|USERS|VIEWS|APPS|AUTH|FEED|HTTP|ITEM|REST|SETS|APP|MRS|NEW|PER|URL)(?![\\w$])"
