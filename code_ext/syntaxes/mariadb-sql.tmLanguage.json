            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.sql",
                    "match": ":="
                },
                {
                    "name": "keyword.operator.json.sql",
                    "match": "->>|->"
                },
                {
                    "name": "keyword.operator.arrow.sql",
                    "match": "=>"
                },
                {
                    "comment": "Before the comparisons: at one position the earlier rule wins, not the longer match.",
                    "name": "keyword.operator.bitwise.sql",
                    "match": "<<|>>"
                },
                {
                    "name": "keyword.operator.comparison.sql",
                    "match": "<=>|<>|!=|<=|>=|=|<|>"
                },
                {
                    "name": "keyword.operator.logical.sql",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.bitwise.sql",
                    "match": "[&|^~]"
                },
                {
                    "name": "keyword.operator.arithmetic.sql",
                    "match": "[-+*/%]"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.sql",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.comma.sql",
                    "match": ","
                },
                {
                    "comment": "A label's, or a REST data mapping's and JSON's.",
                    "name": "punctuation.separator.colon.sql",
                    "match": ":"
                },
                {
                    "name": "keyword.operator.range.sql",
                    "match": "\\.\\."
                },
                {
                    "name": "punctuation.accessor.sql",
                    "match": "\\."
                },
                {
                    "name": "punctuation.section.parens.begin.sql",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.parens.end.sql",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.braces.sql",
                    "match": "[{}]"
                },
                {
                    "comment": "JSON arrays in REST SQL options; the server itself has no use for them outside MSSQL mode.",
                    "name": "punctuation.section.brackets.sql",
                    "match": "[\\[\\]]"
                }
            ]
        },
        "identifier": {
            "patterns": [
                {
                    "comment": "An entity.name, which the themes colour as one: in the 2026 themes orange, in Dark+ the foreground.",
                    "name": "entity.name.identifier.sql",
                    "match": "[\\w$]+"
                },
                {
                    "comment": "Anything else, a stray backslash or bracket, the server returns as a one-character token and then rejects.",
                    "name": "invalid.illegal.character.sql",
                    "match": "\\S"
                }
            ]
        }
    }
