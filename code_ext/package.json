{
  "name": "mariadb-ext",
  "displayName": "MariaDB",
  "description": "The power of MariaDB Shell inside your favorite editor.",
  "publisher": "MariaDB",
  "repository": {
    "type": "git",
    "url": "https://github.com/mariadb-corporation/mariadb-shell-plugins.git"
  },
  "version": "26.9.0",
  "icon": "images/marketplace-icon.png",
  "engines": {
    "vscode": "^1.138.0",
    "node": ">=24.15.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mariadb-view",
          "title": "MariaDB",
          "icon": "images/mariadb-seal.svg"
        }
      ],
      "panel": [
        {
          "id": "mariadb-panel",
          "title": "MariaDB",
          "icon": "images/mariadb-seal.svg"
        }
      ]
    },
    "views": {
      "mariadb-view": [
        {
          "id": "mariadb.connections",
          "name": "Connections",
          "icon": "images/light/connectionMariaDB.svg"
        },
        {
          "id": "mariadb.sandboxes",
          "name": "Sandboxes"
        }
      ],
      "mariadb-panel": [
        {
          "id": "mariadb.results",
          "name": "Results",
          "type": "webview",
          "icon": "images/light/connectionMariaDB.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mariadb.connections",
        "contents": "Looking for MariaDB connections...",
        "when": "mariadb.connectionsView != installing && mariadb.connectionsView != failed && mariadb.connectionsView != listed"
      },
      {
        "view": "mariadb.connections",
        "contents": "Downloading and installing the MariaDB Shell, which this extension runs on. This happens once and can take a minute; the notification shows how far it has got.\n[Show Log](command:mariadb.showMcpServerLog)",
        "when": "mariadb.connectionsView == installing"
      },
      {
        "view": "mariadb.connections",
        "contents": "The connections could not be listed, because the MariaDB Shell could not be installed or started. The log says why.\n[Show Log](command:mariadb.showMcpServerLog)\n[Retry](command:mariadb.restartMcpServer)",
        "when": "mariadb.connectionsView == failed"
      },
      {
        "view": "mariadb.connections",
        "contents": "No MariaDB connections are configured yet.\n[New Connection…](command:mariadb.addConnection)\n[New Folder…](command:mariadb.newFolder)",
        "when": "mariadb.connectionsView == listed"
      },
      {
        "view": "mariadb.sandboxes",
        "contents": "Looking for MariaDB sandboxes...",
        "when": "mariadb.sandboxesView != installing && mariadb.sandboxesView != failed && mariadb.sandboxesView != listed"
      },
      {
        "view": "mariadb.sandboxes",
        "contents": "Waiting for the MariaDB Shell to be installed.\n[Show Log](command:mariadb.showMcpServerLog)",
        "when": "mariadb.sandboxesView == installing"
      },
      {
        "view": "mariadb.sandboxes",
        "contents": "The sandboxes could not be listed. The log says why.\n[Show Log](command:mariadb.showMcpServerLog)\n[Retry](command:mariadb.refreshSandboxes)",
        "when": "mariadb.sandboxesView == failed"
      },
      {
        "view": "mariadb.sandboxes",
        "contents": "A sandbox is a MariaDB server of its own, on this machine, for trying things out. None has been deployed yet.\n[New Sandbox…](command:mariadb.addSandbox)",
        "when": "mariadb.sandboxesView == listed"
      }
    ],
    "configuration": {
      "title": "MariaDB",
      "properties": {
        "mariadb.defaultConnection": {
          "type": "string",
          "default": "",
          "markdownDescription": "The connection URI new SQL editors run on, as listed by `db.list_connections`. Set it from the context menu of a connection in the **Connections** view."
        },
        "mariadb.actions.logAllCalls": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also log the MCP calls that are made on no open connection in the MariaDB panel: listing the connections, and adding, editing, moving, deleting and testing them. They are shown under **General Actions** in the panel's connection picker. Calls made on an open connection are logged under that connection either way."
        },
        "mariadb.connections.connectMode": {
          "type": "string",
          "default": "onOpen",
          "enum": [
            "onOpen",
            "explicit"
          ],
          "enumDescriptions": [
            "Opening a connection in the Connections view connects it.",
            "A connection is only opened by the Connect button or command."
          ],
          "markdownDescription": "How a connection in the **Connections** view is opened. `onOpen` connects as soon as the connection is expanded, and leaves the Connect button off the row; `explicit` keeps the button and never connects on its own."
        },
        "mariadb.execute.stopOnError": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether a failing statement ends the script. Turn this off to run every statement and collect all the failures, which suits a script of independent statements. A single file can be switched from the editor's toolbar without changing this; it starts out doing whatever this says."
        },
        "mariadb.execute.pageSize": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "How many rows of a result set are fetched and shown at a time. A `SELECT` without a `LIMIT` of its own is given one, and the result set's toolbar pages through the rest."
        },
        "mariadb.resultSet.freezePrimaryKeyColumns": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether a result set's primary key columns are frozen: moved to the front of the grid and kept in place while the rest scrolls sideways. A result set can switch this for itself in its toolbar's action menu; each starts out doing what this says."
        },
        "mariadb.keybindings.runScript": {
          "type": "string",
          "default": "cmdOrCtrl+enter",
          "enum": [
            "cmdOrCtrl+enter",
            "shift+enter",
            "cmdOrCtrl+shift+enter",
            "alt+enter",
            "f5",
            "f8",
            "none"
          ],
          "enumDescriptions": [
            "Cmd+Enter on macOS, Ctrl+Enter elsewhere",
            "Shift+Enter",
            "Cmd+Shift+Enter on macOS, Ctrl+Shift+Enter elsewhere",
            "Alt+Enter",
            "F5",
            "F8",
            "No shortcut"
          ],
          "markdownDescription": "The shortcut that runs the whole SQL file (or the selection). Any shortcut outside this list can be set in the Keyboard Shortcuts editor against `mariadb.runSqlFile`."
        },
        "mariadb.keybindings.runStatementAtCursor": {
          "type": "string",
          "default": "shift+enter",
          "enum": [
            "cmdOrCtrl+enter",
            "shift+enter",
            "cmdOrCtrl+shift+enter",
            "alt+enter",
            "f5",
            "f8",
            "none"
          ],
          "enumDescriptions": [
            "Cmd+Enter on macOS, Ctrl+Enter elsewhere",
            "Shift+Enter",
            "Cmd+Shift+Enter on macOS, Ctrl+Shift+Enter elsewhere",
            "Alt+Enter",
            "F5",
            "F8",
            "No shortcut"
          ],
          "markdownDescription": "The shortcut that runs only the statement the cursor is in. Any shortcut outside this list can be set in the Keyboard Shortcuts editor against `mariadb.runSqlStatement`."
        }
      }
    },
    "commands": [
      {
        "command": "mariadb.refreshConnections",
        "title": "Refresh",
        "category": "MariaDB",
        "icon": "$(refresh)"
      },
      {
        "command": "mariadb.deleteConnection",
        "title": "Delete Connection",
        "category": "MariaDB",
        "icon": "$(trash)"
      },
      {
        "command": "mariadb.editConnection",
        "title": "Edit Connection",
        "category": "MariaDB",
        "icon": "$(edit)"
      },
      {
        "command": "mariadb.retryConnection",
        "title": "Retry",
        "category": "MariaDB",
        "icon": "$(refresh)"
      },
      {
        "command": "mariadb.copyConnectionUri",
        "title": "Copy Connection URI",
        "category": "MariaDB",
        "icon": "$(copy)"
      },
      {
        "command": "mariadb.addConnection",
        "title": "New Connection…",
        "category": "MariaDB",
        "icon": "$(add)"
      },
      {
        "command": "mariadb.newFolder",
        "title": "New Folder…",
        "category": "MariaDB",
        "icon": "$(new-folder)"
      },
      {
        "command": "mariadb.newFolderWithSelection",
        "title": "New Folder with Selection…",
        "category": "MariaDB",
        "icon": "$(new-folder)"
      },
      {
        "command": "mariadb.renameFolder",
        "title": "Rename Folder…",
        "category": "MariaDB",
        "icon": "$(edit)"
      },
      {
        "command": "mariadb.removeFolder",
        "title": "Remove Folder",
        "category": "MariaDB",
        "icon": "$(trash)"
      },
      {
        "command": "mariadb.connect",
        "title": "Connect",
        "category": "MariaDB",
        "icon": "$(plug)"
      },
      {
        "command": "mariadb.disconnect",
        "title": "Disconnect",
        "category": "MariaDB",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mariadb.selectRows",
        "title": "Select Rows",
        "category": "MariaDB",
        "icon": {
          "light": "images/light/toolbar-execute.svg",
          "dark": "images/dark/toolbar-execute.svg"
        }
      },
      {
        "command": "mariadb.newSqlEditor",
        "title": "New SQL Editor",
        "category": "MariaDB",
        "icon": "$(new-file)"
      },
      {
        "command": "mariadb.setDefaultConnection",
        "title": "Set as Default Connection",
        "category": "MariaDB",
        "icon": "$(star-empty)"
      },
      {
        "command": "mariadb.clearDefaultConnection",
        "title": "Clear Default Connection",
        "category": "MariaDB",
        "icon": "$(star-full)"
      },
      {
        "command": "mariadb.refreshSandboxes",
        "title": "Refresh",
        "category": "MariaDB",
        "icon": "$(refresh)"
      },
      {
        "command": "mariadb.addSandbox",
        "title": "New Sandbox…",
        "category": "MariaDB",
        "icon": "$(add)"
      },
      {
        "command": "mariadb.startSandbox",
        "title": "Start Sandbox",
        "category": "MariaDB",
        "icon": "$(debug-start)"
      },
      {
        "command": "mariadb.stopSandbox",
        "title": "Stop Sandbox",
        "category": "MariaDB",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mariadb.deleteSandbox",
        "title": "Delete Sandbox",
        "category": "MariaDB",
        "icon": "$(trash)"
      },
      {
        "command": "mariadb.clearResultView",
        "title": "Clear Actions",
        "category": "MariaDB",
        "icon": "$(clear-all)"
      },
      {
        "command": "mariadb.selectEditorConnection",
        "title": "Select Connection for this SQL File",
        "category": "MariaDB",
        "icon": {
          "light": "images/light/connectionMariaDB.svg",
          "dark": "images/dark/connectionMariaDB.svg"
        }
      },
      {
        "command": "mariadb.runSqlFile",
        "title": "Run SQL Script",
        "category": "MariaDB",
        "icon": {
          "light": "images/light/toolbar-execute.svg",
          "dark": "images/dark/toolbar-execute.svg"
        }
      },
      {
        "command": "mariadb.runSqlStatement",
        "title": "Run SQL Statement at Cursor",
        "category": "MariaDB",
        "icon": {
          "light": "images/light/toolbar-execute_caret.svg",
          "dark": "images/dark/toolbar-execute_caret.svg"
        }
      },
      {
        "command": "mariadb.stopOnError.disable",
        "title": "Stop on Error (on)",
        "category": "MariaDB",
        "icon": {
          "light": "images/light/toolbar-stop_on_error-active.svg",
          "dark": "images/dark/toolbar-stop_on_error-active.svg"
        }
      },
      {
        "command": "mariadb.stopOnError.enable",
        "title": "Stop on Error (off)",
        "category": "MariaDB",
        "icon": {
          "light": "images/light/toolbar-stop_on_error-inactive.svg",
          "dark": "images/dark/toolbar-stop_on_error-inactive.svg"
        }
      },
      {
        "command": "mariadb.restartMcpServer",
        "title": "Restart MCP Server",
        "category": "MariaDB"
      },
      {
        "command": "mariadb.showMcpServerLog",
        "title": "Show MCP Server Log",
        "category": "MariaDB"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mariadb.addConnection",
          "when": "view == mariadb.connections",
          "group": "navigation@0"
        },
        {
          "command": "mariadb.newFolder",
          "when": "view == mariadb.connections",
          "group": "navigation@1"
        },
        {
          "command": "mariadb.refreshConnections",
          "when": "view == mariadb.connections",
          "group": "navigation"
        },
        {
          "command": "mariadb.addSandbox",
          "when": "view == mariadb.sandboxes",
          "group": "navigation@0"
        },
        {
          "command": "mariadb.refreshSandboxes",
          "when": "view == mariadb.sandboxes",
          "group": "navigation@1"
        },
        {
          "command": "mariadb.clearResultView",
          "when": "view == mariadb.results",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "mariadb.connect",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\.disconnected/ && !mariadb.connectOnOpen",
          "group": "inline@1"
        },
        {
          "command": "mariadb.disconnect",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\.connected/",
          "group": "inline@1"
        },
        {
          "command": "mariadb.newSqlEditor",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\./",
          "group": "inline@2"
        },
        {
          "command": "mariadb.newSqlEditor",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\./",
          "group": "1_connection@2"
        },
        {
          "command": "mariadb.connect",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\.disconnected/",
          "group": "1_connection@1"
        },
        {
          "command": "mariadb.disconnect",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\.connected/",
          "group": "1_connection@1"
        },
        {
          "command": "mariadb.setDefaultConnection",
          "when": "view == mariadb.connections && viewItem =~ /notDefault$/",
          "group": "2_default@1"
        },
        {
          "command": "mariadb.clearDefaultConnection",
          "when": "view == mariadb.connections && viewItem =~ /\\.default$/",
          "group": "2_default@1"
        },
        {
          "command": "mariadb.editConnection",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\./",
          "group": "3_manage@1"
        },
        {
          "command": "mariadb.deleteConnection",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\./",
          "group": "3_manage@2"
        },
        {
          "command": "mariadb.copyConnectionUri",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\./",
          "group": "4_clipboard@1"
        },
        {
          "command": "mariadb.retryConnection",
          "when": "view == mariadb.connections && viewItem == mariadbConnectionStatus.failed",
          "group": "inline@1"
        },
        {
          "command": "mariadb.addConnection",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbFolder/",
          "group": "inline@1"
        },
        {
          "command": "mariadb.addConnection",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbFolder/",
          "group": "0_new@1"
        },
        {
          "command": "mariadb.newFolder",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbFolder/",
          "group": "0_new@2"
        },
        {
          "command": "mariadb.renameFolder",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbFolder/",
          "group": "1_folder@1"
        },
        {
          "command": "mariadb.removeFolder",
          "when": "view == mariadb.connections && viewItem == mariadbFolder.empty",
          "group": "1_folder@2"
        },
        {
          "command": "mariadb.newFolderWithSelection",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbConnection\\./",
          "group": "9_folder@1"
        },
        {
          "command": "mariadb.retryConnection",
          "when": "view == mariadb.connections && viewItem == mariadbConnectionStatus.failed",
          "group": "1_connection@1"
        },
        {
          "command": "mariadb.selectRows",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbObject\\.(table|view)$/",
          "group": "1_data@1"
        },
        {
          "command": "mariadb.selectRows",
          "when": "view == mariadb.connections && viewItem =~ /^mariadbObject\\.(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "mariadb.startSandbox",
          "when": "view == mariadb.sandboxes && viewItem == mariadbSandbox.stopped",
          "group": "inline@1"
        },
        {
          "command": "mariadb.stopSandbox",
          "when": "view == mariadb.sandboxes && viewItem == mariadbSandbox.running",
          "group": "inline@1"
        },
        {
          "command": "mariadb.deleteSandbox",
          "when": "view == mariadb.sandboxes && viewItem =~ /^mariadbSandbox\\.(running|stopped)$/",
          "group": "inline@2"
        },
        {
          "command": "mariadb.startSandbox",
          "when": "view == mariadb.sandboxes && viewItem == mariadbSandbox.stopped",
          "group": "1_sandbox@1"
        },
        {
          "command": "mariadb.stopSandbox",
          "when": "view == mariadb.sandboxes && viewItem == mariadbSandbox.running",
          "group": "1_sandbox@1"
        },
        {
          "command": "mariadb.deleteSandbox",
          "when": "view == mariadb.sandboxes && viewItem =~ /^mariadbSandbox\\.(running|stopped)$/",
          "group": "2_manage@1"
        }
      ],
      "editor/title": [
        {
          "command": "mariadb.selectEditorConnection",
          "when": "resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "mariadb.runSqlFile",
          "when": "resourceLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "mariadb.runSqlStatement",
          "when": "resourceLangId == sql",
          "group": "navigation@3"
        },
        {
          "command": "mariadb.stopOnError.disable",
          "when": "resourceLangId == sql && mariadb.stopOnError",
          "group": "navigation@4"
        },
        {
          "command": "mariadb.stopOnError.enable",
          "when": "resourceLangId == sql && !mariadb.stopOnError",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "mariadb.runSqlFile",
          "when": "resourceLangId == sql",
          "group": "mariadb@1"
        },
        {
          "command": "mariadb.runSqlStatement",
          "when": "resourceLangId == sql",
          "group": "mariadb@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mariadb.selectRows",
          "when": "false"
        },
        {
          "command": "mariadb.connect",
          "when": "false"
        },
        {
          "command": "mariadb.disconnect",
          "when": "false"
        },
        {
          "command": "mariadb.newSqlEditor",
          "when": "false"
        },
        {
          "command": "mariadb.setDefaultConnection",
          "when": "false"
        },
        {
          "command": "mariadb.refreshConnections",
          "when": "false"
        },
        {
          "command": "mariadb.runSqlFile",
          "when": "editorLangId == sql"
        },
        {
          "command": "mariadb.selectEditorConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "mariadb.runSqlStatement",
          "when": "editorLangId == sql"
        },
        {
          "command": "mariadb.stopOnError.disable",
          "when": "editorLangId == sql && mariadb.stopOnError"
        },
        {
          "command": "mariadb.stopOnError.enable",
          "when": "editorLangId == sql && !mariadb.stopOnError"
        },
        {
          "command": "mariadb.clearResultView",
          "when": "false"
        },
        {
          "command": "mariadb.editConnection",
          "when": "false"
        },
        {
          "command": "mariadb.deleteConnection",
          "when": "false"
        },
        {
          "command": "mariadb.copyConnectionUri",
          "when": "false"
        },
        {
          "command": "mariadb.retryConnection",
          "when": "false"
        },
        {
          "command": "mariadb.removeFolder",
          "when": "false"
        },
        {
          "command": "mariadb.renameFolder",
          "when": "false"
        },
        {
          "command": "mariadb.newFolderWithSelection",
          "when": "false"
        },
        {
          "command": "mariadb.startSandbox",
          "when": "false"
        },
        {
          "command": "mariadb.stopSandbox",
          "when": "false"
        },
        {
          "command": "mariadb.deleteSandbox",
          "when": "false"
        },
        {
          "command": "mariadb.refreshSandboxes",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mariadb.runSqlFile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runScript == 'cmdOrCtrl+enter'"
      },
      {
        "command": "mariadb.runSqlFile",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runScript == 'shift+enter'"
      },
      {
        "command": "mariadb.runSqlFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runScript == 'cmdOrCtrl+shift+enter'"
      },
      {
        "command": "mariadb.runSqlFile",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runScript == 'alt+enter'"
      },
      {
        "command": "mariadb.runSqlFile",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runScript == 'f5'"
      },
      {
        "command": "mariadb.runSqlFile",
        "key": "f8",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runScript == 'f8'"
      },
      {
        "command": "mariadb.runSqlStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runStatement == 'cmdOrCtrl+enter'"
      },
      {
        "command": "mariadb.runSqlStatement",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runStatement == 'shift+enter'"
      },
      {
        "command": "mariadb.runSqlStatement",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runStatement == 'cmdOrCtrl+shift+enter'"
      },
      {
        "command": "mariadb.runSqlStatement",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runStatement == 'alt+enter'"
      },
      {
        "command": "mariadb.runSqlStatement",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runStatement == 'f5'"
      },
      {
        "command": "mariadb.runSqlStatement",
        "key": "f8",
        "when": "editorTextFocus && editorLangId == sql && mariadb.chord.runStatement == 'f8'"
      }
    ]
  },
