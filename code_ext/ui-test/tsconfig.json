{
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "target": "ES2022",
        "lib": ["ES2023"],
        "types": ["node", "mocha"],
        "outDir": "../out/ui-test",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "sourceMap": true
    },
    "include": ["**/*.ts"]
}
