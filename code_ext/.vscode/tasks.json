// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			// Runs to completion before the watcher starts. It cannot be
			// chained into the watch script itself: its "built in" line
			// would satisfy the watcher's endsPattern and let the
			// extension host launch before dist/extension.js exists.
			"label": "build: webview",
			"type": "npm",
			"script": "build:webview",
			"presentation": {
				"reveal": "silent"
			},
			"problemMatcher": []
		},
		{
			"label": "watch",
			"type": "npm",
			"script": "watch",
			"dependsOn": [
				"build: webview"
			],
			"problemMatcher": {
				"owner": "vite",
				// esbuild reports absolute paths.
				"fileLocation": "absolute",
				"pattern": {
					// e.g. /path/src/extension.ts:278:14: ERROR: Unexpected "="
					"regexp": "^(?:\\[[^\\]]+\\]\\s*)?([/\\\\].*?|[A-Za-z]:\\\\.*?):(\\d+):(\\d+):\\s+(ERROR|WARNING|error|warning):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^(build started|vite v[\\d.]+ building)",
					// A failed rebuild never prints "built in", so the
					// failure lines have to end the task as well -
					// otherwise F5 waits for a build that never finishes.
					"endsPattern": "(built in |Transform failed|error during build|Could not resolve)"
				}
			},
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "test",
			"type": "npm",
			"script": "test",
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		}
	]
}
