{
	"files.exclude": {
		"dist": false // set this to true to hide the "dist" folder with the bundled JS
	},
	"search.exclude": {
		"dist": true, // set this to false to include "dist" in search results
		"coverage": true
	},
	// Turn off tsc task auto detection since we have the necessary tasks as npm scripts
	"js/ts.tsc.autoDetect": "off"
}
